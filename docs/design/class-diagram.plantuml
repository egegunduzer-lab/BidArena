@startuml
skinparam classAttributeIconSize 0

class User {
  + int id
  + string email
  + string passwordHash
  + string fullName
  + string phone
  + string role
  + boolean isVerified
  + DateTime createdAt
}

class Subscription {
  + int id
  + int userId
  + string plan
  + int listingQuota
  + string status
  + DateTime startsAt
  + DateTime endsAt
}

class Listing {
  + int id
  + int sellerId
  + string title
  + string description
  + string defects
  + string category
  + string city
  + string district
  + string status
  + DateTime createdAt
}

class Auction {
  + int id
  + int listingId
  + int startPrice
  + int minIncrement
  + int currentPrice
  + int highestBidId
  + DateTime startTime
  + DateTime endTime
  + int extensionCount
  + string status
  + int winnerId
}

class Bid {
  + int id
  + int auctionId
  + int bidderId
  + int amount
  + boolean isAuto
  + string idempotencyKey
  + DateTime createdAt
}

class Appointment {
  + int id
  + int auctionId
  + int buyerId
  + int sellerId
  + int agreedPrice
  + string location
  + DateTime meetingTime
  + boolean buyerAccepted
  + boolean sellerAccepted
  + string otpHash
  + string status
}

class Subscription {
    + int id
    + int user_id
    + string plan_type
    + datetime expires_at
}

class Watchlist {
    + int id
    + int user_id
    + int auction_id
}

class AutoBidLimit {
    + int id
    + int user_id
    + float max_limit
}

class DeliveryConfirmation {
    + int id
    + int auction_id
    + boolean is_delivered
}

class Dispute {
    + int id
    + int auction_id
    + string reason
    + string status
}

class Evidence {
    + int id
    + int dispute_id
    + string file_url
}

class TrustEvent {
    + int id
    + int user_id
    + string event_type
    + float weight
}

class BackupOffer {
    + int id
    + int auction_id
    + float amount
}

class Notification {
    + int id
    + int user_id
    + string message
    + boolean is_read
}

class AuditLog {
    + int id
    + string action
    + datetime timestamp
}

class BidService {
    + place_bid(user_id: int, auction_id: int, amount: float)
    + validate_bid()
}

class BidPolicy {
    + check_rules()
    + calculate_min_increment()
}

class AuctionCloser {
    + close_expired_auctions()
    + determine_winner()
}

class AuctionQueries {
    + get_active_auctions()
    + search_auctions()
}

class ConnectionManager {
    + active_connections: list
    + connect(websocket)
    + disconnect(websocket)
    + broadcast(message: string)
}

' Strategy Design Pattern Sınıfları
interface ITrustScoreStrategy {
  + calculate_score(userId: int): float
}

class BuyerTrustStrategy {
  + calculate_score(userId: int): float
}

class SellerTrustStrategy {
  + calculate_score(userId: int): float
}

' İlişkiler (Associations & Realization)
User "1" --> "0..*" Listing : creates >
User "1" --> "0..*" Subscription : has >
Listing "1" --> "1" Auction : opens >
Auction "1" --> "0..*" Bid : receives >
Auction "1" --> "0..1" Appointment : results in >

ITrustScoreStrategy <|.. BuyerTrustStrategy
ITrustScoreStrategy <|.. SellerTrustStrategy

@enduml